# Environment Variables Configuration
# Copy this file to .env and fill in your values

# 1. Google Gemini API Key
# Required for the automated content generation script.
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. NVIDIA AI API Key (Optional / Informational)
# If you wish to use NVIDIA's open-source model catalog (like Llama 3, Mixtral, etc.),
# you must register at NVIDIA NGC and generate an API key. 
# Get yours here: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your_nvidia_api_key_here

# 4. Blog Publishing API Key (Optional)
# Used to authenticate external AI clients (like Claude, ChatGPT, etc.)
# so they can publish blog posts directly to your portfolio.
# Default fallback is 'javis_secret_blog_token' if not set.
BLOG_API_KEY=javis_secret_blog_token
# You must manually obtain them and place them securely in your .env file.

# 3. GitHub Personal Access Token (Optional)
# Used to authenticate with the GitHub API for higher rate limits.
# Generate one here: https://github.com/settings/tokens
GITHUB_TOKEN=
